[node name="Hints" type="Node2D" parent="." unique_id=1127024198]

[node name="Hint_Welcome" type="Area2D" parent="Hints" unique_id=452696438]
script = ExtResource("script_hint")
title = "Welcome"
body = "Move with W A S D (or the arrow keys) and aim with the mouse.
Walk right to keep going."
trigger_size = Vector2(280, 220)

[node name="Hint_Sprinting" type="Area2D" parent="Hints" unique_id=1386374023]
position = Vector2(300, 0)
script = ExtResource("script_hint")
title = "Sprinting"
body = "Hold Shift to sprint. It drains your stamina bar (under your health, top-left), so use it in bursts. Stamina refills a moment after you stop."
trigger_size = Vector2(260, 220)

[node name="Hint_LootContainers" type="Area2D" parent="Hints" unique_id=1651177198]
position = Vector2(640, 0)
script = ExtResource("script_hint")
title = "Loot containers"
body = "Walk up to a container and press E to open it. Click Take (or Take All) to move items into your backpack.
Grab everything from the supply crate."
trigger_size = Vector2(300, 220)

[node name="Hint_Inventory" type="Area2D" parent="Hints" unique_id=652654099]
position = Vector2(920, 0)
script = ExtResource("script_hint")
title = "Your inventory"
body = "Press Tab or I to open it. Click the USP Match to equip it.
Drag items to move or stack them. Right-click drops one; Shift + right-click drops the whole stack. Press Tab again to close."
trigger_size = Vector2(260, 220)

[node name="Hint_Shooting" type="Area2D" parent="Hints" unique_id=29012945]
position = Vector2(1200, 0)
script = ExtResource("script_hint")
title = "Shooting"
body = "Left-click (or press Enter) to fire. Moving makes your shots less accurate, so stop to line up a shot.
Keys 1 / 2 / 3 switch between your primary, secondary and melee slots."
trigger_size = Vector2(280, 260)

[node name="Hint_Practice" type="Area2D" parent="Hints" unique_id=1134358586]
position = Vector2(1440, 0)
script = ExtResource("script_hint")
title = "Reloading and looting"
body = "Press R to reload. Your magazine and spare ammo are shown in the bottom-right panel.
Shoot the practice dummies. Defeated enemies leave a body - press E on it to loot (these drop ammo)."
trigger_size = Vector2(260, 260)

[node name="Hint_Resin" type="Area2D" parent="Hints" unique_id=1393884299]
position = Vector2(1740, 0)
script = ExtResource("script_hint")
title = "Crafting materials"
body = "Resin is what you craft with. Take it all from the stash - you will use it at the Fabricator just ahead."
trigger_size = Vector2(280, 220)

[node name="Hint_Fabricator" type="Area2D" parent="Hints" unique_id=154100115]
position = Vector2(2040, 0)
script = ExtResource("script_hint")
title = "The Fabricator"
body = "It starts locked. Press 2 to select your Multitool, stand next to the Fabricator and left-click to hack it.
Once it lights up, press E to open crafting. Try the MP7 (30 Resin) or Ammo (5 Resin)."
trigger_size = Vector2(300, 260)

[node name="Hint_Combat" type="Area2D" parent="Hints" unique_id=1862810188]
position = Vector2(2340, 0)
script = ExtResource("script_hint")
title = "Combat"
body = "Enemies notice you when you come within their range, then chase you. Zombies are slow - back away and shoot.
Watch your health bar. Defeat every zombie ahead to unlock the exit door."
trigger_size = Vector2(300, 260)

