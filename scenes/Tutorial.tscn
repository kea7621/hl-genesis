[ext_resource type="Script" path="res://scripts/Tutorial.gd" id="script_tutorial"]
[ext_resource type="Script" path="res://scripts/TutorialHint.gd" id="script_hint"]
[ext_resource type="Script" path="res://scripts/TutorialUI.gd" id="script_ui"]
